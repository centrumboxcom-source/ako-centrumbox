    "drizzle-orm": "^0.35.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
